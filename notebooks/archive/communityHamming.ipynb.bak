    "\n",
    "import sys\n",
    "# Use the kernel's own interpreter: \"!jupyter\" needs a jupyter script on PATH,\n",
    "# which some kernels lack, while \"-m nbconvert\" only needs nbconvert importable.\n",
    "!{sys.executable} -m nbconvert --to script communityGraphFunctions.ipynb quantumUtility.ipynb\n"
   ]
