      "  iter  16/20  <H_C> = -1.7975\n",
      "  iter  17/20  <H_C> = -1.1078\n",
      "  iter  18/20  <H_C> = -1.7348\n",
      "  iter  19/20  <H_C> = -1.4387\n",
      "  iter  20/20  <H_C> = -1.1206\n"
     ]
    },
