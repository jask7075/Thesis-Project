   "source": [
    "def estimate_circuit_fidelity(isa_circuit, ibm_backend):\n",
    "    \"\"\"Rough fidelity estimate for an ISA circuit, from the backend's calibration.\n",
    "\n",
    "    Multiplies (1 - error) over every gate and readout in the circuit using the\n",
    "    device's *median* error rates.  This ignores crosstalk, idling decoherence\n",
    "    and the actual per-qubit spread, so it is an optimistic upper bound -- if\n",
    "    this number is already tiny, the real run will be worse.\n",
    "\n",
    "    It is worth checking before submitting: a deep QAOA ansatz on a few dozen\n",
    "    qubits can easily land at ~1e-4, i.e. the measured distribution is noise and\n",
    "    the SPSA optimiser would be descending on nothing.\n",
    "\n",
    "    Args:\n",
    "        isa_circuit (QuantumCircuit): The transpiled (ISA) circuit.\n",
    "        ibm_backend (IBMBackend): The backend it was transpiled for.\n",
    "\n",
    "    Returns:\n",
    "        float: Estimated probability that the whole circuit runs error-free.\n",
    "    \"\"\"\n",
    "    target = ibm_backend.target\n",
    "\n",
    "    #Finding median error for each gate type in the circuit, ignoring None entries\n",
    "    def median_error(gate_name):\n",
    "        if gate_name not in target:\n",
    "            return None\n",
    "        errs = [target[gate_name][q].error for q in target[gate_name]\n",
    "                if target[gate_name][q] is not None and target[gate_name][q].error is not None]\n",
    "        return float(np.median(errs)) if errs else None\n",
    "\n",
    "    fidelity = 1.0\n",
    "    counts = dict(isa_circuit.count_ops())\n",
    "    print(f\"\\n{'Gate':<10} {'Count':<8} {'Median err':<12} Contribution\")\n",
    "    print(\"-\" * 48)\n",
    "    for gate, count in sorted(counts.items(), key=lambda kv: -kv[1]):\n",
    "        err = median_error(gate)\n",
    "        if err is None:          # barrier, measure handled below, etc.\n",
    "            continue\n",
    "        contribution = (1.0 - err) ** count \n",
    "        fidelity *= contribution\n",
    "        print(f\"{gate:<10} {count:<8} {err:<12.3e} {contribution:.3e}\")\n",
    "\n",
    "    # Readout, one per qubit that is actually used.  Not num_qubits: an ISA\n",
    "    # circuit is padded out to the full device width (156 here) and counting\n",
    "    # every idle wire would inflate the readout term ~3x.  Not num_clbits\n",
    "    # either: the Estimator path has its measurements stripped, so that is 0.\n",
    "    ro = median_error(\"measure\")\n",
    "    if ro is not None:\n",
    "        active = {isa_circuit.find_bit(q).index\n",
    "                  for inst in isa_circuit.data for q in inst.qubits}\n",
    "        n_ro = len(active)\n",
    "        contribution = (1.0 - ro) ** n_ro\n",
    "        fidelity *= contribution\n",
    "        print(f\"{'readout':<10} {n_ro:<8} {ro:<12.3e} {contribution:.3e}\")\n",
    "\n",
    "    print(\"-\" * 48)\n",
    "    print(f\"{'TOTAL':<10} {'':<8} {'':<12} {fidelity:.3e}\")\n",
    "    #Estimated success probability of the circuit running without errors on the given backend\n",
    "    #General measure of how likely the circuit is to produce the correct result, given the noise characteristics of the backend\n",
    "    return fidelity \n",
    "\n",
    "\n",
    "def run_Hamming_74_hardware(G, N, K, LAMBDA_PENALTY, PARITY_CHECKS, GENERATOR_CHECKS,\n",
    "                            n_iterations=20, shots=4096, env_path=\".env\", seed=123,\n",
    "                            dry_run=True):\n",
    "    \"\"\"Runs the full QAOA pipeline for community detection on IBM Quantum HARDWARE.\n",
    "\n",
    "    This is the hardware twin of run_Hamming_74: identical problem construction\n",
    "    (supernode graph, modularity + parity Hamiltonians, generator-based X mixer,\n",
    "    Steane initial state), but the optimisation and sampling run on a real QPU\n",
    "    instead of AerSimulator.\n",
    "\n",
    "    What differs from the simulator routine\n",
    "    ---------------------------------------\n",
    "    Optimiser   SPSA, not SciPy's Powell/L-BFGS-B.  A gradient-based optimiser\n",
    "                needs one job per parameter per step; SPSA needs one job per\n",
    "                step regardless of parameter count, because both probes are\n",
    "                submitted as a single Estimator pub.  On plans without Sessions\n",
    "                every job queues separately, so job count is the binding cost.\n",
    "\n",
    "    Transpiling Done once, against the real device at optimization_level=3, and\n",
    "                the Hamiltonian is mapped through the resulting layout with\n",
    "                apply_layout.  Recomputing either per iteration would be waste.\n",
    "\n",
    "    Sampling    sample_output_hardware(), not the simulator sample_output().\n",
    "                The latter re-adds measure_all() to an already-transpiled\n",
    "                circuit, which measures physical qubit j into clbit j -- fine\n",
    "                on AerSimulator's trivial layout, scrambled on a QPU where\n",
    "                optimization_level=3 permutes the layout.\n",
    "\n",
    "    Decoding    Unchanged: syndrome-correct each node's codeword, then read the\n",
    "                community from the 4 data bits only.\n",
    "\n",
    "    Cost\n",
    "    ----\n",
    "    n_iterations jobs for the optimisation, plus 1 for the final sample.\n",
    "    dry_run=True stops after transpilation and reports depth, two-qubit gate\n",
    "    count and an estimated fidelity, submitting nothing.  Flip it to False to\n",
    "    actually run.\n",
    "\n",
    "    Args:\n",
    "        G (networkx.Graph): The problem graph.\n",
    "        N (int): The number of nodes in the graph.\n",
    "        K (int): The number of communities.\n",
    "        LAMBDA_PENALTY (float): Penalty coefficient for the parity constraint Hamiltonian.\n",
    "        PARITY_CHECKS (list): Parity check sets, e.g. PARITY_CODES_74 (decoding + initial state).\n",
    "        GENERATOR_CHECKS (list): Generator rows, e.g. GENERATOR_CODES_74 (mixer atoms).\n",
    "        n_iterations (int): SPSA steps = hardware jobs. Default 20.\n",
    "        shots (int): Shots per expectation value. Default 4096.\n",
    "        env_path (str): Path to the .env holding IBM_KEY and CRN.\n",
    "        seed (int): Seed for the SPSA perturbation directions, for reproducibility.\n",
    "        dry_run (bool): If True, stop before submitting any job. Default True.\n",
    "\n",
    "    Returns:\n",
    "        list of str or None: The syndrome-corrected bitstring, or None on a dry run.\n",
    "    \"\"\"\n",
    "    display_graph(G, title=\"Initial Graph for Community Detection\") # Visualise the problem graph\n",
    "\n",
    "    no_of_nodes_in_supernode = 7 # Hamming(7,4) uses 7-bit codewords, so each node maps to 7 qubits\n",
    "\n",
    "    G_onehot_supernodes_labeled = create_supernode(G, no_of_nodes_in_supernode) # Create the supernode graph with 7 copies per original node\n",
    "    display_graph(G_onehot_supernodes_labeled, \"Supernode Structure\") # Visualise the supernode structure\n",
    "\n",
    "    modularity_matrix = create_modularity_matrix(G, N) # Calculate the modularity matrix for the graph\n",
    "\n",
    "    num_qubits, modularity_hamiltonian = create_modularity_penalty_hamiltonian(G, N, modularity_matrix, K, no_of_nodes_in_supernode) # Construct the modularity Hamiltonian encoding the community objective\n",
    "\n",
    "    _, penalty_hamiltonian = create_parity_penalty_hamiltonian(N, no_of_nodes_in_supernode, PARITY_CHECKS, LAMBDA_PENALTY) # Construct the parity penalty Hamiltonian enforcing valid Hamming(7,4) codewords\n",
    "\n",
    "    total_hamiltonian = create_total_cost_hamiltonian(modularity_hamiltonian, penalty_hamiltonian, num_qubits) # Combine modularity and parity terms into the total objective Hamiltonian\n",
    "\n",
    "    mixer_hamitonian = create_generator_based_x_mixer(num_qubits, N, no_of_nodes_in_supernode, GENERATOR_CHECKS=GENERATOR_CHECKS) # Mixer built from generator rows, so every atom is a codeword and the code space is preserved\n",
    "\n",
    "    initial_state = build_steane_code_initial_state(num_qubits, N, no_of_nodes_in_supernode, PARITY_CHECKS=PARITY_CHECKS) # Uniform superposition over each node's 16 codewords, matching the mixer\n",
    "\n",
    "    # QAOA ansatz construction — the LOGICAL circuit, kept for sampling later\n",
    "    circuit = create_qaoa_ansatz(total_hamiltonian, P, N, K, mixer_hamiltonian=mixer_hamitonian,\n",
    "                                 initial_state=initial_state, PARITY_CHECKS=PARITY_CHECKS)\n",
    "    print(f\"\\n\\nQAOA Ansatz: \")\n",
    "    draw_circuit_mpl(circuit, \"QAOA Ansatz Circuit (logical)\") # Draw and display the QAOA ansatz circuit\n",
    "\n",
    "    # ── Connect and pick a device ─────────────────────────────────────────────\n",
    "    service = connect_ibm_service(env_path)\n",
    "    ibm_backend = select_ibm_backend(service, circuit.num_qubits)\n",
    "\n",
    "    # ── Transpile ONCE, Estimator path (measurements stripped) ────────────────\n",
    "    isa_ansatz = transpile_for_hardware(circuit, ibm_backend, strip_measurements=True)\n",
    "\n",
    "    # Map the observable onto the physical qubits the layout chose. The layout is\n",
    "    # fixed after transpilation, so this is done once rather than per iteration.\n",
    "    isa_hamiltonian = total_hamiltonian.apply_layout(isa_ansatz.layout)\n",
    "\n",
    "    # ── Estimate the circuit's fidelity on the chosen backend ─────────────────\n",
    "    fidelity = estimate_circuit_fidelity(isa_ansatz, ibm_backend)\n",
    "\n",
    "    print(f\"\\nJob budget: {n_iterations} SPSA jobs + 1 sampling job = {n_iterations + 1} jobs \"\n",
    "          f\"({shots} shots each)\")\n",
    "\n",
    "    if dry_run:\n",
    "        print(\"\\n*** DRY RUN — nothing submitted. Pass dry_run=False to run on hardware. ***\")\n",
    "        return None\n",
    "\n",
    "    if fidelity < 1e-3:\n",
    "        # Not fatal, just honest: the optimiser will be following noise.\n",
    "        print(f\"\\n!!! WARNING: estimated fidelity {fidelity:.2e} — results will be \"\n",
    "              f\"dominated by noise. Submitting anyway because dry_run=False. !!!\")\n",
    "\n",
    "    # ── Optimisation: SPSA, one job per iteration ─────────────────────────────\n",
    "    initial_params = [INITIAL_GAMMA] * P + [INITIAL_BETA] * P # Same starting point as the simulator routine\n",
    "    estimator = Estimator(mode=ibm_backend)\n",
    "    estimator.options.default_shots = shots\n",
    "    estimator.options.resilience_level = 1   # readout error mitigation (does NOT help gate errors)\n",
    "\n",
    "    rng = np.random.default_rng(seed)\n",
    "    params = np.array(initial_params, dtype=float)\n",
    "    value_tracker = []\n",
    "    for i in range(n_iterations):\n",
    "        # Standard SPSA decay: both the step size and the probe distance shrink\n",
    "        lr = 0.1 / (1 + i * 0.05)\n",
    "        c = 0.1 / (1 + i * 0.01) ** 0.167\n",
    "        params, cost = spsa_step(params, isa_ansatz, isa_hamiltonian, estimator,\n",
    "                                 value_tracker, learning_rate=lr, perturbation=c, rng=rng)\n",
    "        print(f\"  iter {i+1:3d}/{n_iterations}  <H_C> = {cost:.4f}\")\n",
    "\n",
    "    plot_optimizer_results(value_tracker) # Plot the cost function's value over optimisation iterations\n",
    "\n",
    "    # ── Sample the optimised circuit ──────────────────────────────────────────\n",
    "    # Pass the LOGICAL circuit: sample_output_hardware transpiles it with its\n",
    "    # measurements attached, so clbit j still means logical qubit j.\n",
    "    raw_bits = sample_output_hardware(circuit, ibm_backend, num_qubits,\n",
    "                                      optimal_params=params, shots=shots)\n",
    "    final_answer = [str(b) for b in raw_bits]   # decoder works on '0'/'1' characters\n",
    "\n",
    "    # ── Syndrome correction, then decode communities from data bits only ──────\n",
    "    #final_answer = correct_hamming_errors(final_answer, N, no_of_nodes_in_supernode, PARITY_CHECKS)\n",
    "\n",
    "    data_indices = get_data_bit_indices(no_of_nodes_in_supernode)\n",
    "    bits_per_node = num_qubits // N\n",
    "\n",
    "    print(f\"\\nCommunity assignment from data bits {data_indices} (K={K}):\")\n",
    "    print(f\"{'Node':<6} {'Codeword':<{bits_per_node + 2}} {'Data bits':<10} {'Value':<7} Community\")\n",
    "    print(\"-\" * (bits_per_node + 32))\n",
    "\n",
    "    assignment = {}\n",
    "    for i in range(N):\n",
    "        codeword  = final_answer[i * bits_per_node : (i + 1) * bits_per_node]\n",
    "        data_bits = [codeword[q] for q in data_indices]\n",
    "        value     = int(''.join(data_bits), 2)\n",
    "        community = value % K\n",
    "        assignment[i] = community\n",
    "        print(f\"{i:<6} {''.join(codeword):<{bits_per_node + 2}} {''.join(data_bits):<10} {value:<7} {community}\")\n",
    "\n",
    "    nx.set_node_attributes(G, assignment, name=\"community\")\n",
    "    cmap   = plt.get_cmap(\"tab10\")\n",
    "    colors = [cmap(assignment[i] % cmap.N) for i in range(N)]\n",
    "    display_graph(G, title=f\"Detected communities — Hamming(7,4) on {ibm_backend.name}\",\n",
    "                  node_colors=colors)\n",
    "\n",
    "    return final_answer\n",
    "\n",
    "\n",
    "G, N = create_clique_chain_graph(3, 2)  # RoC-2: 2 cliques of size 3 in a cycle -> 6 nodes, 42 qubits\n",
    "K = 2\n",
    "LAMBDA_PENALTY = 5 # Penalty parameter for the Hamiltonian to enforce constraints\n",
    "\n",
    "# dry_run=True connects, selects a device and transpiles, but submits NO jobs.\n",
    "# Set dry_run=False to actually spend quota (n_iterations + 1 jobs).\n",
    "final_answer_hw = run_Hamming_74_hardware(G, N, K, LAMBDA_PENALTY,\n",
    "                                          PARITY_CHECKS=PARITY_CODES_74,\n",
    "                                          GENERATOR_CHECKS=GENERATOR_CODES_74,\n",
    "                                          n_iterations=20, shots=4096,\n",
    "                                          dry_run=False)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "e656a6f1",
   "metadata": {},
   "source": [
    "**Syndrome correction on the hardware result**\n",
    "\n",
    "`run_Hamming_74_hardware` returns the bitstring straight off the QPU — the in-line\n",
    "`correct_hamming_errors` call is commented out — so correction runs here as a separate,\n",
    "inspectable step. It reports how many codewords were already valid, which bits were\n",
    "flipped back, and whether that changed any community assignment."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "610778c5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "========================================================================\n",
      "SYNDROME CORRECTION — Hamming(7,4), hardware result\n",
      "========================================================================\n",
      "Raw bitstring : 111011110010110100111110101010100101110011\n",
      "Codewords already valid before correction: 0/6 (0%)\n",
      "\n",
      "Hamming(7,4) Syndrome Decoding\n",
      "Node   Codeword  Syndrome Status                                     Corrected\n",
      "-------------------------------------------------------------------------\n",
      "0      1110111   001   single-bit error corrected (bit 3)         1111111  *\n",
      "1      1001011   001   single-bit error corrected (bit 3)         1000011  *\n",
      "2      0100111   011   single-bit error corrected (bit 5)         0100101  *\n",
      "3      1101010   100   single-bit error corrected (bit 0)         0101010  *\n",
      "4      1010010   001   single-bit error corrected (bit 3)         1011010  *\n",
      "5      1110011   100   single-bit error corrected (bit 0)         0110011  *\n",
      "\n",
      "6 node(s) corrected.\n",
      "Corrected bitstring: 111111110000110100101010101010110100110011\n",
      "\n",
      "------------------------------------------------------------------------\n",
      "Bits flipped back : 6  ->  node 0 bit 3, node 1 bit 3, node 2 bit 5, node 3 bit 0, node 4 bit 3, node 5 bit 0\n",
      "Nodes corrected   : 6/6\n",
      "\n",
      "Node   Community (raw)   Community (corrected)   Changed\n",
      "------------------------------------------------------------\n",
      "0      1                 1                      \n",
      "1      1                 1                      \n",
      "2      1                 1                      \n",
      "3      0                 0                      \n",
      "4      0                 0                      \n",
      "5      1                 1                      \n",
      "\n",
      "Correction did not change any community assignment.\n",
      "\n",
      "Note: Hamming(7,4) has d=3. Every non-zero syndrome is decoded as a\n",
      "single-bit error, so a block carrying two flips is silently mapped onto\n",
      "the wrong valid codeword. A clean correction report is therefore not\n",
      "evidence of a correct answer when device fidelity is low.\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x600 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "def run_syndrome_correction_on_result(sampled_answer, G, N, K, no_of_nodes_in_supernode,\n",
    "                                      parity_checks, show_graph=True, label=\"hardware\"):\n",
    "    \"\"\"Apply Hamming syndrome correction to a sampled bitstring and report what changed.\n",
    "\n",
    "    run_Hamming_74_hardware returns the bitstring straight off the QPU, with the\n",
    "    in-line call to correct_hamming_errors commented out, so correction is done\n",
    "    here as a separate, inspectable step.  Keeping the two apart is what makes\n",
    "    the code's contribution measurable: the interesting quantity is not the\n",
    "    corrected string on its own but the *difference* between raw and corrected.\n",
    "\n",
    "    What it reports\n",
    "    ---------------\n",
    "    - Per-node syndrome and correction status (via correct_hamming_errors).\n",
    "    - How many of the N codewords were already valid, i.e. landed inside the\n",
    "      code space despite device noise.\n",
    "    - Which nodes had a bit flipped back, and at which position.\n",
    "    - Whether correction actually changed the community assignment, which is the\n",
    "      only thing that affects the final answer.\n",
    "\n",
    "    Idempotence\n",
    "    -----------\n",
    "    Safe to run twice.  Correction maps every block onto a valid codeword, so a\n",
    "    second pass finds all syndromes zero and changes nothing.  If you see\n",
    "    \"0 corrected\" on a first run, the sample was already inside the code space.\n",
    "\n",
    "    Limits of Hamming(7,4)\n",
    "    ----------------------\n",
    "    Minimum distance 3, so it corrects any single-bit error but cannot detect a\n",
    "    double-bit one: two flips carry a block onto a *different valid* codeword,\n",
    "    which decoding silently accepts.  On a device where the estimated fidelity\n",
    "    is ~1e-3 most blocks carry several flips, so a clean \"corrected\" report is\n",
    "    not evidence the answer is right -- see the note printed at the end.\n",
    "    Hamming(8,4) adds the overall parity check and can at least flag these.\n",
    "\n",
    "    Args:\n",
    "        sampled_answer (list of str | list of int | str | None): Bitstring as\n",
    "            returned by the run, index j = logical qubit j.  None (a dry run)\n",
    "            is handled with a message rather than an exception.\n",
    "        G (networkx.Graph): The problem graph, for re-colouring.\n",
    "        N (int): Number of graph nodes.\n",
    "        K (int): Number of communities.\n",
    "        no_of_nodes_in_supernode (int): Codeword length (7 or 8).\n",
    "        parity_checks (list of list of int): PARITY_CODES_74 or PARITY_CODES_84.\n",
    "        show_graph (bool): Redraw the graph from the corrected assignment.\n",
    "        label (str): Name used in printed output, e.g. \"hardware\" or \"simulator\".\n",
    "\n",
    "    Returns:\n",
    "        dict or None: None if sampled_answer is None, otherwise keys 'raw',\n",
    "            'corrected', 'assignment_raw', 'assignment_corrected', 'n_valid',\n",
    "            'n_corrected', 'flipped' and 'assignment_changed'.\n",
    "    \"\"\"\n",
    "    if sampled_answer is None:\n",
    "        print(f\"No {label} result to correct — the run returned None \"\n",
    "              f\"(dry_run=True submits no jobs). Re-run with dry_run=False first.\")\n",
    "        return None\n",
    "\n",
    "    # Accept '0101...', ['0','1',...] or [0,1,...] without fuss.\n",
    "    raw = [str(b) for b in sampled_answer]\n",
    "    expected = N * no_of_nodes_in_supernode\n",
    "    if len(raw) != expected:\n",
    "        raise ValueError(f\"bitstring has {len(raw)} bits, expected \"\n",
    "                         f\"N*L = {N}*{no_of_nodes_in_supernode} = {expected}\")\n",
    "\n",
    "    L = no_of_nodes_in_supernode\n",
    "    data_indices = get_data_bit_indices(L)\n",
    "\n",
    "    def communities(bits):\n",
    "        \"\"\"Community per node, read from the 4 data bits of each codeword.\"\"\"\n",
    "        return {i: int(''.join(bits[i*L + q] for q in data_indices), 2) % K\n",
    "                for i in range(N)}\n",
    "\n",
    "    # ── 1. State before correction ────────────────────────────────────────────\n",
    "    syndromes_before = [compute_syndrome(raw[i*L:(i+1)*L], parity_checks) for i in range(N)]\n",
    "    n_valid = sum(1 for s in syndromes_before if all(b == 0 for b in s))\n",
    "    assignment_raw = communities(raw)\n",
    "\n",
    "    print(f\"\\n{'='*72}\")\n",
    "    print(f\"SYNDROME CORRECTION — Hamming({L},4), {label} result\")\n",
    "    print(f\"{'='*72}\")\n",
    "    print(f\"Raw bitstring : {''.join(raw)}\")\n",
    "    print(f\"Codewords already valid before correction: {n_valid}/{N} \"\n",
    "          f\"({100*n_valid/N:.0f}%)\")\n",
    "\n",
    "    # ── 2. Correct (reuses the existing decoder, which prints its own table) ──\n",
    "    corrected = correct_hamming_errors(list(raw), N, L, parity_checks)\n",
    "\n",
    "    # ── 3. What actually changed ──────────────────────────────────────────────\n",
    "    flipped = [(i, j % L) for i in range(N)\n",
    "               for j in range(i*L, (i+1)*L) if raw[j] != corrected[j]]\n",
    "    assignment_corrected = communities(corrected)\n",
    "    changed = {i for i in range(N) if assignment_raw[i] != assignment_corrected[i]}\n",
    "\n",
    "    print(f\"\\n{'-'*72}\")\n",
    "    print(f\"Bits flipped back : {len(flipped)}\"\n",
    "          + (f\"  ->  \" + \", \".join(f\"node {i} bit {b}\" for i, b in flipped) if flipped else \"\"))\n",
    "    print(f\"Nodes corrected   : {len({i for i, _ in flipped})}/{N}\")\n",
    "\n",
    "    print(f\"\\n{'Node':<6} {'Community (raw)':<17} {'Community (corrected)':<23} Changed\")\n",
    "    print(\"-\" * 60)\n",
    "    for i in range(N):\n",
    "        mark = \"  *\" if i in changed else \"\"\n",
    "        print(f\"{i:<6} {assignment_raw[i]:<17} {assignment_corrected[i]:<23}{mark}\")\n",
    "\n",
    "    if changed:\n",
    "        print(f\"\\nCorrection changed the assignment of {len(changed)} node(s): \"\n",
    "              f\"{sorted(changed)}\")\n",
    "    else:\n",
    "        print(\"\\nCorrection did not change any community assignment.\")\n",
    "\n",
    "    # ── 4. Honest caveat about the code's reach ───────────────────────────────\n",
    "    if L == 7:\n",
    "        print(f\"\\nNote: Hamming(7,4) has d=3. Every non-zero syndrome is decoded as a\\n\"\n",
    "              f\"single-bit error, so a block carrying two flips is silently mapped onto\\n\"\n",
    "              f\"the wrong valid codeword. A clean correction report is therefore not\\n\"\n",
    "              f\"evidence of a correct answer when device fidelity is low.\")\n",
    "\n",
    "    # ── 5. Redraw from the corrected assignment ───────────────────────────────\n",
    "    if show_graph:\n",
    "        nx.set_node_attributes(G, assignment_corrected, name=\"community\")\n",
    "        cmap = plt.get_cmap(\"tab10\")\n",
    "        colors = [cmap(assignment_corrected[i] % cmap.N) for i in range(N)]\n",
    "        display_graph(G, title=f\"Communities after Hamming({L},4) correction ({label})\",\n",
    "                      node_colors=colors)\n",
    "\n",
    "    return {\"raw\": raw,\n",
    "            \"corrected\": corrected,\n",
    "            \"assignment_raw\": assignment_raw,\n",
    "            \"assignment_corrected\": assignment_corrected,\n",
    "            \"n_valid\": n_valid,\n",
    "            \"n_corrected\": len({i for i, _ in flipped}),\n",
    "            \"flipped\": flipped,\n",
    "            \"assignment_changed\": sorted(changed)}\n",
    "\n",
    "\n",
    "# Correct the bitstring produced by the hardware run above.\n",
    "# final_answer_hw is None while run_Hamming_74_hardware is in dry_run mode.\n",
    "correction_hw = run_syndrome_correction_on_result(\n",
    "    final_answer_hw, G, N, K,\n",
    "    no_of_nodes_in_supernode=7,\n",
    "    parity_checks=PARITY_CODES_74,\n",
    "    label=\"hardware\",\n",
    ")\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "347f637a",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Rough work\n",
    "\n",
    "PARITY_CHECK_SETS = [\n",
    "    (0, [2, 4, 6]),   # parity bit at pos 0 checks positions 2, 4, 6\n",
    "    (1, [2, 5, 6]),   # parity bit at pos 1 checks positions 2, 5, 6\n",
    "    (3, [4, 5, 6]),   # parity bit at pos 3 checks positions 4, 5, 6\n",
    "]\n",
    "\n",
    "def count_parity_violations(bitstring: str, n_nodes: int) -> int:\n",
    "    \"\"\"Count how many parity checks are violated in the bitstring.\"\"\"\n",
    "    bits = list(reversed(bitstring))\n",
    "    violations = 0 \n",
    "    \n",
    "    for node in range(n_nodes):\n",
    "        for parity_pos, checked_positions in PARITY_CHECK_SETS:\n",
    "            p_bit = int(bits[node * 7 + parity_pos])\n",
    "            data_xor = 0\n",
    "            for dp in checked_positions:\n",
    "                data_xor ^= int(bits[node * 7 + dp])\n",
    "            if p_bit != data_xor:\n",
    "                violations += 1\n",
    "    \n",
    "    return violations\n",
    "\n",
    "count_parity_violations(\"\".join(final_answer), 6)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3fd6d735",
   "metadata": {},
   "source": [
    "Classical Simulation"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2e31d76a",
   "metadata": {},
   "source": [
    "$H_{mod} = +Σ_q Σ_{i,j} B_{ij} * (2x_{i,q}-1)(2x_{j,q}-1)$"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "05e5101c",
   "metadata": {},
   "outputs": [],
   "source": [
    "'''\n",
    "Classical simulation — Hamming(7,4)\n",
    "Total objective to MINIMISE:\n",
    "\n",
    "  H_total = H_mod + PP\n",
    "\n",
    "  H_mod = +Σ_q Σ_{i,j} B_ij * (2x_{i,q}-1)(2x_{j,q}-1)   (modularity)\n",
    "  PP    = -λ * Σ_i Σ_{p∈P} Π_{q∈p} (2x_{i,q}-1)           (parity penalty)\n",
    "\n",
    "x_{i,q} ∈ {0, 1}  — strictly binary, no relaxation\n",
    "v_{i,q} = 2x_{i,q} - 1  maps {0,1} → {-1,+1}\n",
    "\n",
    "Optimiser: simulated annealing over {0,1}^(N×7) with random bit-flip moves.\n",
    "           Operates directly on binary strings — no rounding needed at decode.\n",
    "'''\n",
    "\n",
    "import numpy as np\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "NO_OF_BITS = 7\n",
    "DATA_BITS = [2, 4, 5, 6]\n",
    "\n",
    "\n",
    "def build_modularity_matrix_hamming(G):\n",
    "    \"\"\"Constructs the modularity matrix B for the Hamming-encoded community detection problem.\n",
    "\n",
    "    Computes B = A - (deg * deg^T) / (2m), where A is the adjacency matrix,\n",
    "    deg is the degree vector, and m is the total number of edges.\n",
    "\n",
    "    Args:\n",
    "        G (networkx.Graph): The original graph for which the modularity matrix is derived.\n",
    "\n",
    "    Returns:\n",
    "        tuple: A tuple containing:\n",
    "            - B (numpy.ndarray): The NxN modularity matrix.\n",
    "            - m (float): The total number of edges in the graph.\n",
    "    \"\"\"\n",
    "    nodes = sorted(G.nodes())\n",
    "    A = nx.to_numpy_array(G, nodelist=nodes) # Convert graph to adjacency matrix with consistent node ordering\n",
    "    m = A.sum() / 2 # Total number of edges (sum of all entries divided by 2)\n",
    "    deg = A.sum(axis=1) # Degree vector: sum of each row gives the degree of each node\n",
    "    B = A - np.outer(deg, deg) / (2 * m) # Modularity matrix: B_ij = A_ij - k_i*k_j / (2m)\n",
    "    return B, m\n",
    "\n",
    "\n",
    "# Objective on binary {0,1} inputs\n",
    "def hamming_objective(x_flat, B, n, lam):\n",
    "    \"\"\"Computes the Hamming-encoded total objective for simulated annealing.\n",
    "\n",
    "    Evaluates H_total = -H_mod + PP, where H_mod is the modularity gain and\n",
    "    PP is the parity penalty. The modularity term is negated so that\n",
    "    minimising H_total corresponds to maximising modularity subject to\n",
    "    valid Hamming codewords.\n",
    "\n",
    "    Args:\n",
    "        x_flat (numpy.ndarray): Flattened binary assignment matrix of shape (n*NO_OF_BITS,).\n",
    "        B (numpy.ndarray): The modularity matrix for the graph.\n",
    "        n (int): The number of nodes in the graph.\n",
    "        lam (float): Penalty coefficient controlling the strength of the parity constraint.\n",
    "\n",
    "    Returns:\n",
    "        float: The total objective value H_total (to be minimised).\n",
    "    \"\"\"\n",
    "    X = x_flat.reshape(n, NO_OF_BITS)\n",
    "    V = 2.0 * X - 1.0 # Map {0,1} → {-1,+1} as required by the modularity quadratic form\n",
    "\n",
    "    h_mod = sum(V[:, q] @ B @ V[:, q] for q in range(NO_OF_BITS)) # Sum modularity contributions across all bit positions\n",
    "    pp = -lam * sum(np.prod(V[i, pc]) for i in range(n) for pc in PARITY_CODES_74) # Parity penalty: penalise codewords violating Hamming(7,4) parity checks\n",
    "\n",
    "    return -h_mod + pp # Negate h_mod to convert maximisation to minimisation\n",
    "\n",
    "\n",
    "# Simulated annealing over {0,1}^(N×7)\n",
    "def run_binary_sa(B, n, lam, T_init=5.0, T_min=1e-4, maxiter=100000, seed=42):\n",
    "    \"\"\"Minimises the Hamming objective using simulated annealing over binary strings.\n",
    "\n",
    "    At each step a single random bit is flipped and the move is accepted via\n",
    "    the Metropolis criterion. Temperature decreases geometrically from T_init\n",
    "    to T_min over maxiter steps.\n",
    "\n",
    "    Args:\n",
    "        B (numpy.ndarray): The modularity matrix for the graph.\n",
    "        n (int): The number of nodes in the graph.\n",
    "        lam (float): Penalty coefficient for the parity constraint.\n",
    "        T_init (float): Initial temperature for the annealing schedule.\n",
    "        T_min (float): Final temperature at which annealing stops.\n",
    "        maxiter (int): Total number of bit-flip proposals.\n",
    "        seed (int): Random seed for reproducibility.\n",
    "\n",
    "    Returns:\n",
    "        tuple: A tuple containing:\n",
    "            - best_x (numpy.ndarray): The best binary solution found.\n",
    "            - best_val (float): The lowest objective value achieved.\n",
    "            - tracker (list[float]): Best-so-far objective value at each improvement.\n",
    "    \"\"\"\n",
    "    rng = np.random.default_rng(seed)\n",
    "    n_vars = n * NO_OF_BITS\n",
    "    cooling = (T_min / T_init) ** (1.0 / maxiter) # Geometric cooling factor applied each iteration\n",
    "\n",
    "    x = rng.integers(0, 2, size=n_vars).astype(float) # Random binary initialisation\n",
    "    val = hamming_objective(x, B, n, lam)\n",
    "    best_x = x.copy()\n",
    "    best_val = val\n",
    "    tracker = [val] # Best-so-far objective value, updated at each improvement\n",
    "\n",
    "    T = T_init\n",
    "    for _ in range(maxiter):\n",
    "        # Propose: flip one random bit\n",
    "        idx = rng.integers(0, n_vars)\n",
    "        x_new = x.copy()\n",
    "        x_new[idx] = 1.0 - x_new[idx]\n",
    "\n",
    "        new_val = hamming_objective(x_new, B, n, lam)\n",
    "        delta = new_val - val\n",
    "\n",
    "        # Metropolis acceptance: always accept improvements, accept worse moves with probability exp(-delta/T)\n",
    "        if delta < 0 or rng.random() < np.exp(-delta / T):\n",
    "            x = x_new\n",
    "            val = new_val\n",
    "            if val < best_val:\n",
    "                best_val = val\n",
    "                best_x = x.copy()\n",
    "                tracker.append(best_val) # Record new best value\n",
    "\n",
    "        T *= cooling # Cool the temperature\n",
    "\n",
    "    print(f\"SA finished | best H_total = {best_val:.4f} | improvements = {len(tracker)-1}\")\n",
    "    return best_x, best_val, tracker\n",
    "\n",
    "\n",
    "# Syndrome correction\n",
    "def syndrome_correct_74(codeword_bits):\n",
    "    \"\"\"Performs single-bit error correction using the Hamming(7,4) syndrome.\n",
    "\n",
    "    Computes a 3-bit syndrome by XORing the bits covered by each parity\n",
    "    check. The syndrome value directly encodes the position of the erroneous\n",
    "    bit (1-indexed), which is then flipped to correct the error.\n",
    "\n",
    "    Args:\n",
    "        codeword_bits (list[int]): A list of 7 binary integers representing the received codeword.\n",
    "\n",
    "    Returns:\n",
    "        list[int]: The corrected codeword as a list of 7 binary integers.\n",
    "    \"\"\"\n",
    "    bits = list(codeword_bits)\n",
    "    syndrome = [\n",
    "        int(np.bitwise_xor.reduce([bits[q] for q in pc])) % 2\n",
    "        for pc in PARITY_CODES_74\n",
    "    ]\n",
    "    error_pos = syndrome[2] * 4 + syndrome[1] * 2 + syndrome[0] - 1 # Decode syndrome to 0-indexed error position (-1 means no error)\n",
    "    if error_pos >= 0:\n",
    "        bits[error_pos] ^= 1 # Flip the erroneous bit to correct it\n",
    "    return bits\n",
    "\n",
    "\n",
    "# Decode binary solution → community assignments\n",
    "def decode_hamming_assignments(x_flat, n, k):\n",
    "    \"\"\"Decodes the binary SA solution into integer community assignments using Hamming(7,4).\n",
    "\n",
    "    For each node, applies syndrome correction to its 7-bit codeword, extracts\n",
    "    the 4 data bits, interprets them as a binary integer, and maps the result\n",
    "    into the valid community range [0, k) via modulo.\n",
    "\n",
    "    Args:\n",
    "        x_flat (numpy.ndarray): Flattened binary solution of shape (n*NO_OF_BITS,).\n",
    "        n (int): The number of nodes in the graph.\n",
    "        k (int): The number of communities.\n",
    "\n",
    "    Returns:\n",
    "        numpy.ndarray: Integer array of shape (n,) giving the community index for each node.\n",
    "    \"\"\"\n",
    "    X = x_flat.reshape(n, NO_OF_BITS).astype(int)\n",
    "\n",
    "    assignments = []\n",
    "    print(\"Syndrome Correction Statistics \")\n",
    "    print(f\"\\n{'Node':<6} {'Codeword':<9} {'After correction':<17} {'Data bits':<11} Community\")\n",
    "    print(\"-\" * 52)\n",
    "    \n",
    "    for i in range(n):\n",
    "        raw = list(X[i])\n",
    "        corrected = syndrome_correct_74(raw) # Apply Hamming(7,4) syndrome correction\n",
    "        data_bits = [corrected[q] for q in DATA_BITS] # Extract the 4 data bits from the corrected codeword\n",
    "        value = int(\"\".join(str(b) for b in data_bits), 2) # Interpret data bits as a big-endian binary integer\n",
    "        community = value % k # Wrap integer into valid community range [0, k)\n",
    "        assignments.append(community)\n",
    "        print(f\"{i:<6} {''.join(map(str, raw)):<9} {''.join(map(str, corrected)):<17} \"\n",
    "              f\"{''.join(map(str, data_bits)):<11} {community}\")\n",
    "\n",
    "    return np.array(assignments)\n",
    "\n",
    "\n",
    "# Visualisation\n",
    "def plot_hamming_convergence(tracker):\n",
    "    \"\"\"Plots the best-so-far objective value over the course of simulated annealing.\n",
    "\n",
    "    Args:\n",
    "        tracker (list[float]): Sequence of best objective values recorded at each improvement.\n",
    "    \"\"\"\n",
    "    plt.figure(figsize=(10, 4))\n",
    "    plt.step(range(len(tracker)), tracker, where=\"post\", color=\"red\", linewidth=1.5)\n",
    "    plt.xlabel(\"Improvement number\")\n",
    "    plt.ylabel(\"Best H_total found\")\n",
    "    plt.title(\"Simulated annealing — Hamming(7,4) best-so-far\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def plot_hamming_communities(G, assignments, k):\n",
    "    \"\"\"Visualises the detected community structure of the graph using colour-coded nodes.\n",
    "\n",
    "    Args:\n",
    "        G (networkx.Graph): The original problem graph.\n",
    "        assignments (numpy.ndarray): Integer array of community indices for each node.\n",
    "        k (int): The number of communities.\n",
    "    \"\"\"\n",
    "    cmap = plt.get_cmap(\"tab10\")\n",
    "    node_colors = [cmap(c % cmap.N) for c in assignments] # Assign a colour to each node based on its community\n",
    "    pos = nx.spring_layout(G, seed=42)\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    nx.draw_networkx_edges(G, pos, edge_color=\"gray\", width=2)\n",
    "    nx.draw_networkx_nodes(G, pos, node_color=node_colors, node_size=700)\n",
    "    nx.draw_networkx_labels(G, pos, font_color=\"white\", font_size=10)\n",
    "    plt.title(f\"Detected Communities — Hamming(7,4), K={k}\")\n",
    "    plt.axis(\"off\")\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def run_hamming74_classical(G, N, K, LAMBDA_PENALTY):\n",
    "    \"\"\"Runs the full Hamming(7,4) classical simulated annealing pipeline.\n",
    "\n",
    "    Constructs the modularity matrix, runs simulated annealing to find the\n",
    "    optimal binary assignment, decodes the result using Hamming(7,4) syndrome\n",
    "    correction, and displays the convergence plot and final community partition.\n",
    "\n",
    "    Args:\n",
    "        G (networkx.Graph): The problem graph.\n",
    "        N (int): The number of nodes in the graph.\n",
    "        K (int): The number of communities.\n",
    "        LAMBDA_PENALTY (float): Penalty coefficient for the parity constraint.\n",
    "    \"\"\"\n",
    "    display_graph(G) # Visualise the problem graph before optimisation\n",
    "    B_ham, m_ham = build_modularity_matrix_hamming(G) # Construct the modularity matrix and retrieve the edge count\n",
    "    print(f\"\\nModularity matrix B = {B_ham}\")\n",
    "\n",
    "    best_x, best_val, tracker = run_binary_sa(B_ham, N, LAMBDA_PENALTY) # Run simulated annealing to find the optimal binary assignment\n",
    "    assignments = decode_hamming_assignments(best_x, N, K) # Decode binary solution into community assignments using syndrome correction\n",
    "\n",
    "    print(f\"\\nOptimal H_total     : {best_val:.4f}\")\n",
    "    print(f\"Community assignments: {assignments}\")\n",
    "\n",
    "    plot_hamming_convergence(tracker) # Plot the best-so-far objective over annealing improvements\n",
    "    plot_hamming_communities(G, assignments, K) # Visualise the final community partition on the graph\n",
    "\n",
    "\n",
    "G, N = get_davis_southern_women_graph()\n",
    "K = 2\n",
    "LAMBDA_PENALTY = 5 # Penalty parameter for the Hamiltonian to enforce constraints\n",
    "\n",
    "run_hamming74_classical(G, N, K, LAMBDA_PENALTY)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d9422db7",
   "metadata": {},
   "source": [
    "Hamming(8,4)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cdfea2e2",
   "metadata": {},
   "outputs": [],
   "source": [
    "def run_Hamming_84(G, N, K, LAMBDA_PENALTY):\n",
    "    \"\"\"Runs the full QAOA pipeline for community detection using Hamming(8,4) encoding.\n",
    "\n",
    "    Constructs the supernode graph, modularity and parity penalty Hamiltonians,\n",
    "    and the QAOA ansatz. Runs classical optimisation on a local AerSimulator,\n",
    "    then samples the optimised circuit and decodes the result using Hamming(8,4)\n",
    "    syndrome correction to obtain final community assignments.\n",
    "\n",
    "    Args:\n",
    "        G (networkx.Graph): The problem graph.\n",
    "        N (int): The number of nodes in the graph.\n",
    "        K (int): The number of communities.\n",
    "        LAMBDA_PENALTY (float): Penalty coefficient for the parity constraint Hamiltonian.\n",
    "\n",
    "    Returns:\n",
    "        list: The final community assignment bitstring decoded from the optimised circuit.\n",
    "    \"\"\"\n",
    "    display_graph(G, title=\"Initial Graph for Community Detection\") # Visualise the problem graph\n",
    "\n",
    "    no_of_nodes_in_supernode = 8 # Hamming(8,4) uses 8-bit codewords, so each node maps to 8 qubits\n",
    "\n",
    "    G_onehot_supernodes_labeled = create_supernode(G, no_of_nodes_in_supernode) # Create the supernode graph with 8 copies per original node\n",
    "    display_graph(G_onehot_supernodes_labeled, \"Supernode Structure\") # Visualise the supernode structure\n",
    "\n",
    "    modularity_matrix = create_modularity_matrix(G, N) # Calculate the modularity matrix for the graph\n",
    "\n",
    "    num_qubits, modularity_hamiltonian = create_modularity_penalty_hamiltonian(G, N, modularity_matrix, K, no_of_nodes_in_supernode) # Construct the modularity Hamiltonian encoding the community objective\n",
    "\n",
    "    _, penalty_hamiltonian = create_parity_penalty_hamiltonian(N, no_of_nodes_in_supernode, PARITY_CODES_84, LAMBDA_PENALTY) # Construct the parity penalty Hamiltonian enforcing valid Hamming(8,4) codewords\n",
    "\n",
    "    total_hamiltonian = create_total_cost_hamiltonian(modularity_hamiltonian, penalty_hamiltonian, num_qubits) # Combine modularity and parity terms into the total objective Hamiltonian\n",
    "\n",
    "    # QAOA ansatz construction\n",
    "    circuit = create_qaoa_ansatz(total_hamiltonian, P, N, K) # Create the QAOA quantum circuit ansatz\n",
    "    print(f\"\\n\\nQAOA Ansatz: \")\n",
    "    draw_circuit_mpl(circuit, \"QAOA Ansatz Circuit\") # Draw and display the QAOA ansatz circuit\n",
    "\n",
    "    # Optimisation process\n",
    "    initial_params = [INITIAL_GAMMA] * P + [INITIAL_BETA] * P # Set initial parameters for the QAOA optimisation\n",
    "    transpiled_qc, backend = run_ansatz_simulator_circuit_prep(circuit, \"mps\") # Prepare the circuit for MPS simulation (efficient for large qubit counts)\n",
    "    result, value_tracker = run_optimizer_simulator(transpiled_qc, backend, initial_params, total_hamiltonian) # Run the classical optimiser to find optimal QAOA parameters\n",
    "    plot_optimizer_results(value_tracker) # Plot the cost function's value over optimisation iterations\n",
    "\n",
    "    # Result extraction and interpretation\n",
    "    optimized_circuit = transpiled_qc.assign_parameters(result.x) # Assign the optimised parameters to the quantum circuit\n",
    "    print(f\"\\n\\nThe circuit with optimized parameters: \")\n",
    "    draw_circuit_mpl(optimized_circuit, \"Optimized Circuit\") # Draw and display the optimised circuit\n",
    "\n",
    "    # Sample measurement outcomes, apply syndrome correction, and decode community assignments from data bits\n",
    "    final_answer = sample_output(G, optimized_circuit, backend, num_qubits,\n",
    "                                 no_of_nodes_in_supernode, PARITY_CODES_84)\n",
    "    return final_answer\n",
    "\n",
    "\n",
    "G, N = create_clique_chain_graph(3, 3)\n",
    "K = 2\n",
    "LAMBDA_PENALTY = 5 # Penalty parameter for the Hamiltonian to enforce constraints\n",
    "\n",
    "run_Hamming_84(G, N, K, LAMBDA_PENALTY)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7285033a",
   "metadata": {},
   "source": [
    "Classical Simulation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5ecf48af",
   "metadata": {},
   "outputs": [],
   "source": [
    "'''\n",
    "\n",
    "Classical simulation — Hamming(8,4)\n",
    "Total objective to MINIMISE:\n",
    "\n",
    "  H_total = -H_mod(reason being it's converted into quadratic form) + PP\n",
    "\n",
    "  H_mod = +Σ_q Σ_{i,j} B_ij * (2x_{i,q}-1)(2x_{j,q}-1)   (modularity)\n",
    "  PP    = -λ * Σ_i Σ_{p∈P} Π_{q∈p} (2x_{i,q}-1)           (parity penalty)\n",
    "\n",
    "x_{i,q} ∈ {0, 1}  — strictly binary, no relaxation\n",
    "v_{i,q} = 2x_{i,q} - 1  maps {0,1} → {-1,+1}\n",
    "\n",
    "Optimiser: simulated annealing over {0,1}^(N×8) with random bit-flip moves.\n",
    "           Operates directly on binary strings — no rounding needed at decode.\n",
    "'''\n",
    "           \n",
    "import numpy as np\n",
    "import networkx as nx\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "NO_OF_BITS = 8\n",
    "DATA_BITS = [2, 4, 5, 6]\n",
    "\n",
    "\n",
    "def build_modularity_matrix_hamming(G):\n",
    "    \"\"\"Constructs the modularity matrix B for the Hamming-encoded community detection problem.\n",
    "\n",
    "    Computes B = A - (deg * deg^T) / (2m), where A is the adjacency matrix,\n",
    "    deg is the degree vector, and m is the total number of edges.\n",
    "\n",
    "    Args:\n",
    "        G (networkx.Graph): The original graph for which the modularity matrix is derived.\n",
    "\n",
    "    Returns:\n",
    "        tuple: A tuple containing:\n",
    "            - B (numpy.ndarray): The NxN modularity matrix.\n",
    "            - m (float): The total number of edges in the graph.\n",
    "    \"\"\"\n",
    "    nodes = sorted(G.nodes())\n",
    "    A = nx.to_numpy_array(G, nodelist=nodes) # Convert graph to adjacency matrix with consistent node ordering\n",
    "    m = A.sum() / 2 # Total number of edges (sum of all entries divided by 2)\n",
    "    deg = A.sum(axis=1) # Degree vector: sum of each row gives the degree of each node\n",
    "    B = A - np.outer(deg, deg) / (2 * m) # Modularity matrix: B_ij = A_ij - k_i*k_j / (2m)\n",
    "    return B, m\n",
    "\n",
    "\n",
    "# Objective on binary {0,1} inputs \n",
    "def hamming_objective(x_flat, B, n, lam):\n",
    "    \"\"\"Computes the Hamming(8,4)-encoded total objective for simulated annealing.\n",
    "\n",
    "    Evaluates H_total = -H_mod + PP, where H_mod is the modularity gain and\n",
    "    PP is the parity penalty. The modularity term is negated so that\n",
    "    minimising H_total corresponds to maximising modularity subject to\n",
    "    valid Hamming(8,4) codewords.\n",
    "\n",
    "    Args:\n",
    "        x_flat (numpy.ndarray): Flattened binary assignment matrix of shape (n*NO_OF_BITS,).\n",
    "        B (numpy.ndarray): The modularity matrix for the graph.\n",
    "        n (int): The number of nodes in the graph.\n",
    "        lam (float): Penalty coefficient controlling the strength of the parity constraint.\n",
    "\n",
    "    Returns:\n",
    "        float: The total objective value H_total (to be minimised).\n",
    "    \"\"\"\n",
    "    X = x_flat.reshape(n, NO_OF_BITS)\n",
    "    V = 2.0 * X - 1.0 # Map {0,1} → {-1,+1} as required by the modularity quadratic form\n",
    "\n",
    "    h_mod = sum(V[:, q] @ B @ V[:, q] for q in range(NO_OF_BITS)) # Sum modularity contributions across all bit positions\n",
    "    pp = -lam * sum(np.prod(V[i, pc]) for i in range(n) for pc in PARITY_CODES_84) # Parity penalty: penalise codewords violating Hamming(8,4) parity checks\n",
    "\n",
    "    return -h_mod + pp # Negate h_mod to convert maximisation to minimisation\n",
    "\n",
    "\n",
    "# Simulated annealing over {0,1}^(N×8) \n",
    "def run_binary_sa(B, n, lam, T_init=5.0, T_min=1e-4, maxiter=100000, seed=42):\n",
    "    \"\"\"Minimises the Hamming(8,4) objective using simulated annealing over binary strings.\n",
    "\n",
    "    At each step a single random bit is flipped and the move is accepted via\n",
    "    the Metropolis criterion. Temperature decreases geometrically from T_init\n",
    "    to T_min over maxiter steps.\n",
    "\n",
    "    Args:\n",
    "        B (numpy.ndarray): The modularity matrix for the graph.\n",
    "        n (int): The number of nodes in the graph.\n",
    "        lam (float): Penalty coefficient for the parity constraint.\n",
    "        T_init (float): Initial temperature for the annealing schedule.\n",
    "        T_min (float): Final temperature at which annealing stops.\n",
    "        maxiter (int): Total number of bit-flip proposals.\n",
    "        seed (int): Random seed for reproducibility.\n",
    "\n",
    "    Returns:\n",
    "        tuple: A tuple containing:\n",
    "            - best_x (numpy.ndarray): The best binary solution found.\n",
    "            - best_val (float): The lowest objective value achieved.\n",
    "            - tracker (list[float]): Best-so-far objective value at each improvement.\n",
    "    \"\"\"\n",
    "    rng = np.random.default_rng(seed)\n",
    "    n_vars = n * NO_OF_BITS\n",
    "    cooling = (T_min / T_init) ** (1.0 / maxiter) # Geometric cooling factor applied each iteration\n",
    "\n",
    "    x = rng.integers(0, 2, size=n_vars).astype(float) # Random binary initialisation\n",
    "    val = hamming_objective(x, B, n, lam)\n",
    "    best_x = x.copy()\n",
    "    best_val = val\n",
    "    tracker = [val] # Best-so-far objective value, updated at each improvement\n",
    "\n",
    "    T = T_init\n",
    "    for _ in range(maxiter):\n",
    "        # Propose: flip one random bit\n",
    "        idx = rng.integers(0, n_vars)\n",
    "        x_new = x.copy()\n",
    "        x_new[idx] = 1.0 - x_new[idx]\n",
    "\n",
    "        new_val = hamming_objective(x_new, B, n, lam)\n",
    "        delta = new_val - val\n",
    "\n",
    "        # Metropolis acceptance: always accept improvements, accept worse moves with probability exp(-delta/T)\n",
    "        if delta < 0 or rng.random() < np.exp(-delta / T):\n",
    "            x = x_new\n",
    "            val = new_val\n",
    "            if val < best_val:\n",
    "                best_val = val\n",
    "                best_x = x.copy()\n",
    "                tracker.append(best_val) # Record new best value\n",
    "\n",
    "        T *= cooling # Cool the temperature\n",
    "\n",
    "    print(f\"SA finished | best H_total = {best_val:.4f} | improvements = {len(tracker)-1}\")\n",
    "    return best_x, best_val, tracker\n",
    "\n",
    "\n",
    "# Syndrome correction\n",
    "def syndrome_correct_84(codeword_bits):\n",
    "    \"\"\"Performs single-bit error correction using the Hamming(8,4) syndrome.\n",
    "\n",
    "    Computes a 3-bit syndrome from parity bits P1, P2, P3 to locate a single-bit\n",
    "    error. The overall parity bit P4 (XOR of all 8 bits) then distinguishes\n",
    "    single-bit errors (correctable) from double-bit errors (detectable only).\n",
    "\n",
    "    Args:\n",
    "        codeword_bits (list[int]): A list of 8 binary integers representing the received codeword.\n",
    "\n",
    "    Returns:\n",
    "        list[int]: The corrected codeword as a list of 8 binary integers.\n",
    "    \"\"\"\n",
    "    bits = list(codeword_bits)\n",
    "\n",
    "    # 3-bit syndrome from P1, P2, P3 only (indices 0,1,2 of PARITY_CODES_84)\n",
    "    syndrome = [\n",
    "        int(np.bitwise_xor.reduce([bits[q] for q in PARITY_CODES_84[k]])) % 2\n",
    "        for k in range(3)\n",
    "    ]\n",
    "    # P4: XOR of all 8 bits — used to distinguish single-bit from double-bit errors\n",
    "    p4 = int(np.bitwise_xor.reduce(bits)) % 2\n",
    "\n",
    "    error_pos = syndrome[2] * 4 + syndrome[1] * 2 + syndrome[0] - 1 # Decode syndrome to 0-indexed error position (-1 means no error)\n",
    "\n",
    "    if p4 == 1 and error_pos >= 0:      # Single-bit error — correct it\n",
    "        bits[error_pos] ^= 1\n",
    "    elif p4 == 0 and error_pos >= 0:    # Double-bit error — detect only, cannot correct\n",
    "        print(\"  Warning: double-bit error detected, cannot correct.\")\n",
    "    # p4==0 & error_pos<0 → no error\n",
    "\n",
    "    return bits\n",
    "\n",
    "\n",
    "# Decode binary solution → community assignments \n",
    "def decode_hamming_assignments_84(x_flat, n, k):\n",
    "    \"\"\"Decodes the binary SA solution into integer community assignments using Hamming(8,4).\n",
    "\n",
    "    For each node, applies Hamming(8,4) syndrome correction to its 8-bit codeword,\n",
    "    extracts the 4 data bits, interprets them as a binary integer, and maps the\n",
    "    result into the valid community range [0, k) via modulo.\n",
    "\n",
    "    Args:\n",
    "        x_flat (numpy.ndarray): Flattened binary solution of shape (n*NO_OF_BITS,).\n",
    "        n (int): The number of nodes in the graph.\n",
    "        k (int): The number of communities.\n",
    "\n",
    "    Returns:\n",
    "        numpy.ndarray: Integer array of shape (n,) giving the community index for each node.\n",
    "    \"\"\"\n",
    "    X = x_flat.reshape(n, NO_OF_BITS).astype(int)\n",
    "\n",
    "    assignments = []\n",
    "    print(\"Syndrome Correction Statistics \")\n",
    "    print(f\"\\n{'Node':<6} {'Codeword':<9} {'After correction':<17} {'Data bits':<11} Community\")\n",
    "    print(\"-\" * 52)\n",
    "    for i in range(n):\n",
    "        raw = list(X[i])\n",
    "        corrected = syndrome_correct_84(raw) # Apply Hamming(8,4) syndrome correction\n",
    "        data_bits = [corrected[q] for q in DATA_BITS] # Extract the 4 data bits from the corrected codeword\n",
    "        value = int(\"\".join(str(b) for b in data_bits), 2) # Interpret data bits as a big-endian binary integer\n",
    "        community = value % k # Wrap integer into valid community range [0, k)\n",
    "        assignments.append(community)\n",
    "        print(f\"{i:<6} {''.join(map(str, raw)):<9} {''.join(map(str, corrected)):<17} \"\n",
    "              f\"{''.join(map(str, data_bits)):<11} {community}\")\n",
    "\n",
    "    return np.array(assignments)\n",
    "\n",
    "\n",
    "# Visualisation \n",
    "def plot_hamming_convergence(tracker):\n",
    "    \"\"\"Plots the best-so-far objective value over the course of simulated annealing.\n",
    "\n",
    "    Args:\n",
    "        tracker (list[float]): Sequence of best objective values recorded at each improvement.\n",
    "    \"\"\"\n",
    "    plt.figure(figsize=(10, 4))\n",
    "    plt.step(range(len(tracker)), tracker, where=\"post\", color=\"red\", linewidth=1.5)\n",
    "    plt.xlabel(\"Improvement number\")\n",
    "    plt.ylabel(\"Best H_total found\")\n",
    "    plt.title(\"Simulated annealing — Hamming(8,4) best-so-far\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def plot_hamming_communities(G, assignments, k):\n",
    "    \"\"\"Visualises the detected community structure of the graph using colour-coded nodes.\n",
    "\n",
    "    Args:\n",
    "        G (networkx.Graph): The original problem graph.\n",
    "        assignments (numpy.ndarray): Integer array of community indices for each node.\n",
    "        k (int): The number of communities.\n",
    "    \"\"\"\n",
    "    cmap = plt.get_cmap(\"tab10\")\n",
    "    node_colors = [cmap(c % cmap.N) for c in assignments] # Assign a colour to each node based on its community\n",
    "    pos = nx.spring_layout(G, seed=42)\n",
    "    plt.figure(figsize=(8, 6))\n",
    "    nx.draw_networkx_edges(G, pos, edge_color=\"gray\", width=2)\n",
    "    nx.draw_networkx_nodes(G, pos, node_color=node_colors, node_size=700)\n",
    "    nx.draw_networkx_labels(G, pos, font_color=\"white\", font_size=10)\n",
    "    plt.title(f\"Detected Communities — Hamming(8,4), K={k}\")\n",
    "    plt.axis(\"off\")\n",
    "    plt.show()\n",
    "\n",
    "def run_hamming84_classical(G, N, K, LAMBDA_PENALTY ):\n",
    "    \"\"\"Runs the full Hamming(8,4) classical simulated annealing pipeline.\n",
    "\n",
    "    Constructs the modularity matrix, runs simulated annealing to find the\n",
    "    optimal binary assignment, decodes the result using Hamming(7,4) syndrome\n",
    "    correction, and displays the convergence plot and final community partition.\n",
    "\n",
    "    Args:\n",
    "        G (networkx.Graph): The problem graph.\n",
    "        N (int): The number of nodes in the graph.\n",
    "        K (int): The number of communities.\n",
    "        LAMBDA_PENALTY (float): Penalty coefficient for the parity constraint.\n",
    "    \"\"\"\n",
    "    display_graph(G) # Visualise the problem graph before optimisation\n",
    "    B, m = build_modularity_matrix_hamming(G) # Construct the modularity matrix and retrieve the edge count\n",
    "    print(f\"\\nModularity matrix B = {B}\")\n",
    "\n",
    "    best_x, best_val, tracker = run_binary_sa(B, N, LAMBDA_PENALTY) # Run simulated annealing to find the optimal binary assignment\n",
    "    assignments = decode_hamming_assignments_84(best_x, N, K) # Decode binary solution into community assignments using syndrome correction\n",
    "\n",
    "    print(f\"\\nOptimal H_total     : {best_val:.4f}\")\n",
    "    print(f\"Community assignments: {assignments}\")\n",
    "\n",
    "    plot_hamming_convergence(tracker) # Plot the best-so-far objective over annealing improvements\n",
    "    plot_hamming_communities(G, assignments, K) # Visualise the final community partition on the graph\n",
    "\n",
    "G, N = create_clique_chain_graph(3, 2)\n",
    "K = 2\n",
    "LAMBDA_PENALTY = 1 # Penalty parameter for the Hamiltonian to enforce constraints\n",
    "\n",
    "run_hamming84_classical(G, N, K, LAMBDA_PENALTY )"
   ]
  },
